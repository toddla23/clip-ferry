<?xml version="1.0" encoding="utf-8"?>
<!-- 키는 Keystore에 묶여 기기 밖으로 못 나간다. 백업에 비밀 파일이 들어가면 복원 후 열 수 없으니 전부 제외한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

# deploy/.env.cloud 예시 (F40). 복사해서 값을 채운다: cp deploy/env.cloud.example deploy/.env.cloud && chmod 600 deploy/.env.cloud
# .env.cloud는 git에 넣지 않는다.

# Azure가 준 이름 (VM → 공용 IP → DNS 이름 레이블)
CF_DOMAIN=clipferry.japaneast.cloudapp.azure.com
# Let's Encrypt 만료 안내를 받을 메일
CF_ACME_EMAIL=you@example.com

# 받을 이미지 태그: main(머지 뒤) / f40-azure-deploy(브랜치 시험) / sha-xxxxxxx(고정)
CF_IMAGE_TAG=main

# Pi의 deploy/.env.account에서 그대로 옮긴다 (계정·토큰을 유지하려면 서명 키가 같아야 한다)
CF_DB_PASSWORD=
CF_ACCOUNT_SIGNING_KEY=
CF_GOOGLE_CLIENT_IDS=
CF_GOOGLE_WEB_CLIENT_ID=
CF_GOOGLE_DESKTOP_CLIENT_ID=
CF_GOOGLE_DESKTOP_CLIENT_SECRET=
CF_ADMIN_EMAILS=

# 릴레이 → 계정 서버 사용량 보고 비밀 (새로 만든다: openssl rand -hex 24)
CF_USAGE_SECRET=
